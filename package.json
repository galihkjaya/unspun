    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.2",
    "jiti": "2.7.0",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
